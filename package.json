{
  "name": "anchor-monorepo",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "web:dev": "pnpm --filter apps-web dev",
    "web:build": "pnpm --filter apps-web build",
    "web:start": "pnpm --filter apps-web start",
    "chrome:build": "pnpm --filter apps-chrome-ext build",
    "vscode:build": "pnpm --filter apps-vscode-ext build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^9.0.0",
    "globals": "^17.6.0",
    "png2icons": "^2.0.1",
    "sharp": "0.34.5",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
