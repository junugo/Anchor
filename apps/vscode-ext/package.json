{
  "name": "apps-vscode-ext",
  "displayName": "Anchor",
  "description": "Anchor 节律守护：键入活动上报与状态栏节律着色（配合自托管 Anchor 服务器）",
  "version": "0.0.1",
  "publisher": "junugo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/junugo/Anchor"
  },
  "private": true,
  "type": "module",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node build.mjs",
    "vscode:prepublish": "pnpm build",
    "package": "vsce package --no-dependencies",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Anchor",
      "properties": {
        "anchor.serverUrl": {
          "type": "string",
          "default": "http://localhost:4000",
          "description": "Anchor 服务器地址（配对成功后自动写入工作区设置）"
        }
      }
    },
    "commands": [
      {
        "command": "anchor.signin",
        "title": "Anchor: 配对（输入服务器地址与配对码）"
      },
      {
        "command": "anchor.repair",
        "title": "Anchor: 重新配对（覆盖旧设备凭证）"
      },
      {
        "command": "anchor.helloWorld",
        "title": "Anchor: Hello World"
      }
    ]
  },
  "dependencies": {
    "@anchor/api-client": "workspace:*",
    "@anchor/types": "workspace:*",
    "@anchor/utils": "workspace:*",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@anchor/ui": "workspace:*",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.3.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  }
}
