import { Palette } from "theme.slint";
import { TitleBar } from "components/title-bar.slint";
import { AnchorButton } from "components/button.slint";
import { AnchorCheck } from "components/check-box.slint";

// 设置窗口：仅桌面端自身设置（服务器决策项在 Web 端管理）
export component SettingsWindow inherits Window {
    title: "Anchor 设置";
    icon: @image-url("../assets/icon.png");
    no-frame: true;
    width: 400px;
    // 720px 装不下完整内容（保存按钮被裁），提到 840 小屏若再裁剪需启用 std-widgets 后用 ScrollView
    height: 840px;
    background: transparent;

    in-out property <string> server-url: "";
    in-out property <string> pair-code: "";
    in-out property <string> device-name: "";
    // 已配对状态展示：设备名 · 服务器地址（重新配对入口会本地临时置 false 显示输入区）
    in-out property <bool> paired: false;
    in property <string> paired-info: "";
    // 已配对时只读展示数据密钥指纹前 8 位（v2 由配对自动下发，不再手动输入）
    in property <string> key-fingerprint: "";
    // 配对操作反馈（成功/失败文案）
    in property <string> pair-status: "";
    in-out property <bool> autostart: true;
    in-out property <bool> tracking-enabled: true;
    in-out property <bool> notifications-enabled: true;
    // pill 位置索引：0左上 1中上 2右上 3左下 4右下
    in-out property <int> pill-position: 4;
    in property <bool> saved: false;

    callback drag-to(length, length);
    callback close-requested();
    callback save-clicked();
    // 点击「配对 / 重新配对」：由 Rust 侧读取 pair-code / device-name / server-url
    callback pair-clicked();
    // 倒计时位置变更：临时弹出示意窗预览（保存/取消后关闭）
    callback position-preview-changed(int);

    Rectangle {
        border-radius: 8px;
        clip: true;
        background: Palette.bg;
        border-width: 1px;
        border-color: Palette.border;

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            TitleBar {
                title: "设置";
                drag-to(dx, dy) => { root.drag-to(dx, dy); }
                close-requested => { root.close-requested(); }
            }

            // 内容顶部对齐：已配对态内容较矮，多余空白沉底而非被 stretch 分摊到卡片之间
            VerticalLayout {
                padding: 16px;
                padding-top: 12px;
                spacing: 10px;
                alignment: start;

                Text {
                    text: "设置";
                    font-size: 18px;
                    font-weight: 600;
                    color: Palette.text-primary;
                }
                Text {
                    text: "桌面端自身设置；宵禁与服务器决策在 Web 端管理";
                    font-size: 12px;
                    color: Palette.text-secondary;
                }

                // ── 配对区 ──
                Rectangle {
                    background: Palette.surface;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: root.paired ? Palette.border : Palette.accent;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: "配对";
                                font-size: 13px;
                                font-weight: 600;
                                color: root.paired ? Palette.text-primary : Palette.accent;
                            }
                            Text {
                                text: root.paired ? "已配对" : "未配对";
                                font-size: 12px;
                                color: root.paired ? Palette.ok : Palette.accent;
                                vertical-alignment: center;
                            }
                        }

                        if root.paired: Text {
                            text: root.paired-info;
                            font-size: 12px;
                            color: Palette.text-secondary;
                            wrap: word-wrap;
                        }

                        if root.paired && root.key-fingerprint != "": Text {
                            text: "数据密钥指纹 " + root.key-fingerprint;
                            font-size: 11px;
                            color: Palette.text-disabled;
                            wrap: word-wrap;
                        }

                        if root.paired: AnchorButton {
                            label: "重新配对";
                            primary: false;
                            clicked => { root.paired = false; }
                        }

                        if !root.paired: Text {
                            text: "输入 Web 端设置页生成的 8 位配对码";
                            font-size: 11px;
                            color: Palette.text-disabled;
                        }

                        // 服务器地址移入配对卡：配对与连接同源，未配对时必填
                        if !root.paired: Text {
                            text: "服务器地址";
                            font-size: 12px;
                            color: Palette.text-primary;
                        }

                        if !root.paired: Rectangle {
                            height: 32px;
                            border-radius: 6px;
                            background: Palette.surface;
                            border-width: 1px;
                            border-color: url-input.has-focus ? Palette.accent : Palette.border;

                            url-input := TextInput {
                                x: 10px;
                                width: parent.width - 20px;
                                height: parent.height;
                                vertical-alignment: center;
                                font-size: 13px;
                                single-line: true;
                                color: Palette.text-primary;
                                selection-background-color: Palette.accent-muted;
                                selection-foreground-color: Palette.text-primary;
                                text <=> root.server-url;
                            }
                        }

                        if !root.paired: Text {
                            text: "配对码";
                            font-size: 12px;
                            color: Palette.text-primary;
                        }

                        if !root.paired: Rectangle {
                            height: 32px;
                            border-radius: 6px;
                            background: Palette.surface;
                            border-width: 1px;
                            border-color: code-input.has-focus ? Palette.accent : Palette.border;

                            code-input := TextInput {
                                x: 10px;
                                width: parent.width - 20px;
                                height: parent.height;
                                vertical-alignment: center;
                                font-size: 13px;
                                single-line: true;
                                color: Palette.text-primary;
                                selection-background-color: Palette.accent-muted;
                                selection-foreground-color: Palette.text-primary;
                                text <=> root.pair-code;
                            }
                        }

                        if !root.paired: Text {
                            text: "设备名";
                            font-size: 12px;
                            color: Palette.text-primary;
                        }

                        if !root.paired: Rectangle {
                            height: 32px;
                            border-radius: 6px;
                            background: Palette.surface;
                            border-width: 1px;
                            border-color: name-input.has-focus ? Palette.accent : Palette.border;

                            name-input := TextInput {
                                x: 10px;
                                width: parent.width - 20px;
                                height: parent.height;
                                vertical-alignment: center;
                                font-size: 13px;
                                single-line: true;
                                color: Palette.text-primary;
                                selection-background-color: Palette.accent-muted;
                                selection-foreground-color: Palette.text-primary;
                                text <=> root.device-name;
                            }
                        }

                        if !root.paired: AnchorButton {
                            label: "配对";
                            primary: true;
                            clicked => { root.pair-clicked(); }
                        }

                        if root.pair-status != "": Text {
                            text: root.pair-status;
                            font-size: 12px;
                            color: root.paired ? Palette.ok : Palette.accent;
                            wrap: word-wrap;
                        }
                    }
                }

                Rectangle {
                    background: Palette.surface;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Palette.border;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;

                        AnchorCheck {
                            label: "开机自启";
                            checked <=> root.autostart;
                        }
                        AnchorCheck {
                            label: "窗口焦点追踪";
                            checked <=> root.tracking-enabled;
                        }
                        AnchorCheck {
                            label: "桌面通知";
                            checked <=> root.notifications-enabled;
                        }

                        Text {
                            text: "倒计时位置";
                            font-size: 13px;
                            color: Palette.text-primary;
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            height: 28px;

                            for label[i] in ["左上", "中上", "右上", "左下", "右下"]: Rectangle {
                                horizontal-stretch: 1;
                                border-radius: 6px;
                                background: root.pill-position == i ? Palette.accent-muted : Palette.bg;
                                border-width: 1px;
                                border-color: root.pill-position == i ? Palette.accent : Palette.border;

                                Text {
                                    text: label;
                                    font-size: 12px;
                                    color: root.pill-position == i ? Palette.accent : Palette.text-secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    clicked => {
                                        root.pill-position = i;
                                        root.position-preview-changed(i);
                                    }
                                }
                            }
                        }

                        Text {
                            text: "追踪开关变更约 30s 内生效；服务器地址变更立即重连。数据密钥由配对自动下发";
                            font-size: 11px;
                            color: Palette.text-disabled;
                            wrap: word-wrap;
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    height: 30px;

                    if root.saved: Text {
                        text: "已保存";
                        font-size: 12px;
                        color: Palette.ok;
                        vertical-alignment: center;
                    }
                    AnchorButton {
                        label: "保存";
                        primary: true;
                        clicked => { root.save-clicked(); }
                    }
                }
            }
        }
    }
}
