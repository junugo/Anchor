import { Palette } from "theme.slint";

// 入睡确认窗：服务器怀疑用户已睡着时弹出。
// 只有「还没睡」一个按钮——能点击即证明醒着；无响应则由服务器超时自动确认睡着，
// 并广播 sleep:confirm-cancel（或本地 confirm_until 到期）销毁本窗。
export component SleepConfirmWindow inherits Window {
    title: "Anchor Sleep Confirm";
    icon: @image-url("../assets/icon.png");
    no-frame: true;
    always-on-top: true;
    width: 360px;
    height: 170px;
    background: transparent;

    callback not-yet-requested();
    callback close-requested();

    Rectangle {
        border-radius: 10px;
        background: Palette.dark-bg;
        border-width: 1px;
        border-color: Palette.dark-border;

        VerticalLayout {
            padding: 20px;
            spacing: 12px;

            Text {
                text: "睡着了吗？";
                font-size: 17px;
                font-weight: 600;
                color: Palette.dark-text;
            }
            Text {
                text: "Anchor 检测到你很久没活动，推测你可能已经入睡。若没有回应，将自动视为已睡着。";
                font-size: 12px;
                color: Palette.dark-text-secondary;
                wrap: word-wrap;
            }

            Rectangle {
                height: 34px;
                Rectangle {
                    width: 110px;
                    height: 32px;
                    x: parent.width - self.width;
                    border-radius: 6px;
                    background: notyet-ta.has-hover ? #d0702f : Palette.accent;

                    notyet-ta := TouchArea {
                        clicked => { root.not-yet-requested(); }
                    }
                    Text {
                        text: "还没睡";
                        font-size: 13px;
                        color: #ffffff;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
