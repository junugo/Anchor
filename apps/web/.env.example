# Anchor Server 配置
PORT=4000

# 用户时区（默认 Asia/Shanghai）。所有作息时钟（宵禁、睡眠日界、DailyContext 等）均按此时区计算
# ANCHOR_TZ=Asia/Shanghai

# SQLite 数据库路径（默认 ~/.anchor/anchor.db）
# ANCHOR_DB_PATH=/path/to/anchor.db

# DeepSeek API Key（必填，AI 提醒功能依赖）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# FocusLayer 联动（可选）
# 如果 FocusLayer Server 运行在非默认地址，填写此项
# FOCUSLAYER_SERVER_URL=http://localhost:3000

# FocusLayer API Key（可选，与 FocusLayer 联动时必填）
# FOCUSLAYER_API_KEY=your_focuslayer_api_key

# 上行行为数据加密密钥（生产必填，必须与所有客户端一致）
# ANCHOR_DATA_KEY=your_anchor_data_key
