# Anchor Server 配置
PORT=4000

# 用户时区（默认 Asia/Shanghai）。所有作息时钟（宵禁、睡眠日界、DailyContext 等）均按此时区计算
# ANCHOR_TZ=Asia/Shanghai

# SQLite 数据库路径（默认 ~/.anchor/anchor.db）
# ANCHOR_DB_PATH=/path/to/anchor.db

# ── AI 提供商（BYOK，Bring Your Own Key）────────────────────────────
# 支持任意 OpenAI 兼容 chat completions 端点。不配置则 AI 功能静默降级。
#
# ANCHOR_AI_API_KEY — 提供商 API Key（必填项，AI 对话/提醒/摘要/仲裁/分类依赖）
# ANCHOR_AI_MODEL   — 模型名，默认 deepseek-chat
# ANCHOR_AI_BASE_URL — 端点前缀，默认 https://api.deepseek.com/v1
#
# 常用组合示例：
#   DeepSeek（默认）:  ANCHOR_AI_BASE_URL=https://api.deepseek.com/v1   ANCHOR_AI_MODEL=deepseek-chat
#   OpenAI:           ANCHOR_AI_BASE_URL=https://api.openai.com/v1      ANCHOR_AI_MODEL=gpt-4o-mini
#   Moonshot:         ANCHOR_AI_BASE_URL=https://api.moonshot.cn/v1     ANCHOR_AI_MODEL=moonshot-v1-8k
#   本地 Ollama:      ANCHOR_AI_BASE_URL=http://localhost:11434/v1      ANCHOR_AI_MODEL=qwen3:8b
ANCHOR_AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANCHOR_AI_MODEL=deepseek-chat
# ANCHOR_AI_BASE_URL=https://api.deepseek.com/v1
# 注意：旧版变量 DEEPSEEK_API_KEY 已移除，迁移 = 改名为 ANCHOR_AI_API_KEY

# FocusLayer 联动（可选）
# 如果 FocusLayer Server 运行在非默认地址，填写此项
# FOCUSLAYER_SERVER_URL=http://localhost:3000

# FocusLayer API Key（可选，与 FocusLayer 联动时必填）
# FOCUSLAYER_API_KEY=your_focuslayer_api_key

# 上行行为数据加密密钥（生产必填，必须与所有客户端一致）
# ANCHOR_DATA_KEY=your_anchor_data_key
